{
  "name": "@atlas.api/agent",
  "version": "0.2.0",
  "description": "Reads your backend on your own machine and sends the API map to the Atlas web app. Also makes localhost reachable.",
  "type": "module",
  "bin": {
    "atlas-agent": "./index.mjs",
    "atlas.api": "./index.mjs"
  },
  "main": "./index.mjs",
  "files": ["index.mjs", "lib", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softtunners/atlas.api.git"
  },
  "homepage": "https://github.com/softtunners/atlas.api#readme",
  "bugs": { "url": "https://github.com/softtunners/atlas.api/issues" },
  "keywords": ["api", "http", "localhost", "proxy", "atlas", "rest-client", "openapi", "discovery"],
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": { "access": "public" }
}
